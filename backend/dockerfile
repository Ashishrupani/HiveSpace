# backend/Dockerfile

FROM node:22-alpine

WORKDIR /app

# Copy package files for deterministic installs
COPY package*.json ./

# Install production dependencies only (skips jest, nodemon, babel, etc.)
RUN npm ci --omit=dev

# Adding a block to have root only in app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy only what's needed to run the app
COPY controllers/ ./controllers/
COPY middleware/ ./middleware/
COPY models/ ./models/
COPY routes/ ./routes/
COPY app.js .
COPY server.js .

# Lock down file ownership
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 5000

CMD ["node", "server.js"]